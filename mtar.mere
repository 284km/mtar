// mtar.mere — CLI.
//
//   mtar list    <archive.tar>
//   mtar extract <archive.tar> <dest-dir>
//   mtar layer   <archive.tar> <dest-dir>   (extract, honouring whiteouts)
//   mtar create  <archive.tar> <dir>
//   mtar upper   <archive.tar> <dir>      (create, from an overlay upper dir)
//
// `layer` and `extract` differ on one thing: whether a name beginning with
// `.wh.` is a file or a deletion. Nothing in the archive says which, so the
// two spellings are how the caller says which it meant.

import "tar.mere";

let argv = args () in
let usage = fn (unit_: unit) ->
  let _ = print_err ("usage: mtar list <archive.tar>"
                  ++ " | mtar extract <archive.tar> <dest>"
                  ++ " | mtar layer <archive.tar> <dest>"
                  ++ " | mtar create <archive.tar> <dir>"
                  ++ " | mtar upper <archive.tar> <overlay-upper-dir>") in
  exit 2;

// The library records a refusal and returns -1; the CLI is where that becomes
// a message and a non-zero exit, which is what a CLI should do and what a
// daemon must not.
let report = fn (verb: str) -> fn (n: int) ->
  if n < 0 then
    let _ = print_err ("mtar: refused: " ++ fs_last_error ()) in
    exit 3
  else print_err ("mtar: " ++ verb ++ " " ++ show n ++ " entries");

match argv with
| ["list", a]        -> report "listed" (walk a "." false)
| ["extract", a, d]  -> let _ = mkdir_p d in report "extracted" (walk a d true)
| ["layer", a, d]    -> let _ = mkdir_p d in report "applied" (walk_opt a d true true)
| ["create", a, d]   -> report "wrote" (tar_create a d)
| ["upper", a, d]    -> report "wrote" (tar_create_layer a d)
| _                  -> usage ()
