// mtar.mere — CLI.
//
//   mtar list    <archive.tar>
//   mtar extract <archive.tar> <dest-dir>

import "tar.mere";

let argv = args () in
let usage = fn (unit_: unit) ->
  let _ = print_err "usage: mtar list <archive.tar> | mtar extract <archive.tar> <dest>" in
  exit 2;

match argv with
| ["list", a]        -> let n = walk a "." false in print_err ("mtar: " ++ show n ++ " entries")
| ["extract", a, d]  -> let _ = mkdir_p d in
                        let n = walk a d true in print_err ("mtar: extracted " ++ show n ++ " entries")
| _                  -> usage ()
